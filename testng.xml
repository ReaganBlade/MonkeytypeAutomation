<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Suite" parallel="tests" thread-count="3">


    <test name="MonkeyType_Chrome">
        <parameter name="webDriver" value="chrome"></parameter>
        <classes>
            <class name="MonkeyTypeTest"/>
        </classes>
    </test>

    <test name="MonkeyType_Edge">
        <parameter name="webDriver" value="edge"></parameter>
        <classes>
            <class name="MonkeyTypeTest"/>
        </classes>
    </test>

    <test name="MonkeyType_Firefox">
        <parameter name="webDriver" value="firefox"></parameter>
        <classes>
            <class name="MonkeyTypeTest"/>
        </classes>
    </test>
</suite>
